# Fail loudly on unmet peer dependencies rather than shipping a subtly broken tree.
strict-peer-dependencies=true

# Keep the workspace honest: a package must declare what it imports.
# Without this, an app can import a transitive dep that later disappears.
auto-install-peers=false
resolve-peers-from-workspace-root=true

# Next.js and Playwright expect a resolvable node_modules layout.
shamefully-hoist=false
node-linker=isolated

# Reproducible CI installs.
prefer-frozen-lockfile=true
