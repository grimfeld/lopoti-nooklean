# Back office — environment variables.
#
# Copy this file to .env.local for local development.
# On Vercel, set the same names under Project Settings > Environment Variables.
#
# This is the ONLY app that holds secrets. The two public sites are deployed
# with no environment variables at all.

# --- Database --------------------------------------------------------------
# Production and preview: injected automatically by the Neon integration.
# Local development: start Postgres with `pnpm db:local:up` first.
#
# Port 55432 is deliberate — see packages/db/.env.example. A Postgres already
# installed on this machine would occupy the usual 5432.
DATABASE_URL=postgres://dev:dev@localhost:55432/lopoti_nooklean

# --- Back-office login -----------------------------------------------------
# The shared password. Use a long passphrase — it is the only thing standing
# between the internet and every customer request.
ADMIN_PASSWORD=change-me-to-a-long-passphrase

# Signing key for the session cookie. Generate a fresh one with:
#   openssl rand -hex 32
ADMIN_SECRET=replace-with-32-bytes-of-hex-from-openssl-rand

# --- Public site origins ---------------------------------------------------
# The two public sites call this API across origins, so they must be allowlisted.
# Preview deployments are matched by pattern and need no entry here.
# Leave these unset locally: localhost:3001 and :3002 are allowed automatically
# outside production.
# PUBLIC_ORIGIN_LOPOTI=https://lopoti.vercel.app
# PUBLIC_ORIGIN_NOOKLEAN=https://nooklean.vercel.app
