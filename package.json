{
  "name": "lopoti-nooklean",
  "private": true,
  "packageManager": "pnpm@9.11.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "verify": "turbo run typecheck lint test",
    "db:migrate": "pnpm --filter @lopoti-nooklean/db migrate",
    "db:migrate:check": "pnpm --filter @lopoti-nooklean/db migrate:check",
    "db:local:up": "docker compose up -d postgres",
    "db:local:down": "docker compose down",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,css,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,css,md,yml,yaml}\""
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "prettier": "^3.3.3",
    "sharp": "^0.35.4",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  }
}
