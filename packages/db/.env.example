# Postgres connection string.
#
# Production / preview: injected automatically by the Neon integration on Vercel.
# You should never paste a production connection string by hand.
#
# Local development (docker compose — see docker-compose.yml at the repo root).
#
# Note the port: 55432, not the usual 5432. If a Postgres is already installed
# on this machine it occupies 5432, and connecting there would silently hit that
# server instead of the project's container.
DATABASE_URL=postgres://dev:dev@localhost:55432/lopoti_nooklean

# Neon and some Vercel integrations provision under this name instead.
# The code accepts either; DATABASE_URL wins when both are set.
# POSTGRES_URL=
